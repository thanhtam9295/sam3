# Copy to env/.env.dev for Microsoft 365 Agents Toolkit (never commit the copy).
TEAMS_APP_ID=00000000-0000-0000-0000-000000000000
DEVELOPER_NAME=Your organisation
DEVELOPER_WEBSITE_URL=https://example.org
PRIVACY_URL=https://example.org/privacy
TERMS_URL=https://example.org/terms
SAM3_SERVICE_URL=https://sam3-api.internal.example.org
SAM3_SERVICE_DOMAIN=sam3-api.internal.example.org
# Created in the Teams Developer Portal (OAuth client registration); an ID, not a secret.
SAM3_OAUTH_REFERENCE_ID=
