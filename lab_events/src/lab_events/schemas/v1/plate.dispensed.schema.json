{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hcs-studio.local/lab_events/v1/plate.dispensed.schema.json",
  "title": "Compounds were dispensed into a plate (treatment time)",
  "type": "object",
  "required": [
    "barcode",
    "dispensed_at"
  ],
  "properties": {
    "barcode": {
      "type": "string",
      "minLength": 1
    },
    "dispensed_at": {
      "type": "string",
      "description": "RFC 3339 date-time with time zone"
    },
    "dispenser": {
      "type": "string"
    },
    "transfer_file": {
      "type": "string"
    },
    "protocol": {
      "type": "string"
    }
  }
}
