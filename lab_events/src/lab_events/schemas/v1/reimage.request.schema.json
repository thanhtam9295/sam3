{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hcs-studio.local/lab_events/v1/reimage.request.schema.json",
  "title": "Ask the scheduler to image (part of) a plate again",
  "type": "object",
  "required": [
    "barcode",
    "reason"
  ],
  "properties": {
    "barcode": {
      "type": "string",
      "minLength": 1
    },
    "acquisition_id": {
      "type": "string"
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "wells": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z]{1,2}[0-9]{1,3}$"
      }
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "well",
          "field"
        ],
        "properties": {
          "well": {
            "type": "string"
          },
          "field": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "requested_by": {
      "type": "string"
    }
  }
}
