{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hcs-studio.local/lab_events/v1/analysis.started.schema.json",
  "title": "HCS Studio started analysing an acquisition",
  "type": "object",
  "required": [
    "barcode",
    "run_id",
    "started_at"
  ],
  "properties": {
    "barcode": {
      "type": "string",
      "minLength": 1
    },
    "acquisition_id": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "pipeline": {
      "type": "string"
    },
    "started_at": {
      "type": "string",
      "description": "RFC 3339 date-time with time zone"
    }
  }
}
