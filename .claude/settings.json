{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "ask": [
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh release:*)",
      "Bash(gh repo:*)",
      "Bash(twine upload:*)",
      "Bash(python tools/validation/regenerate_baselines.py:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/credentials*.json)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  }
}
